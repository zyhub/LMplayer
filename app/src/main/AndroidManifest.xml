<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础网络与局域网多播发现权限 (AirPlay mDNS / DLNA SSDP / 音频路由控制) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 前台服务权限与多版本适配 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 挂后台时手机顶部灵动岛悬浮窗权限与开机自启权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 在线应用自更新与安装器调起权限 (Android 8.0+) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Android 13 (API 33) 起 READ_EXTERNAL_STORAGE 对媒体文件**完全失效**，必须改用
        按类型划分的 READ_MEDIA_AUDIO。缺这条会导致 Android 13/14 手机上
        「一键全盘扫描」「导入本地文件夹」「U 盘扫描」全部返回 0 首（MediaStore 查询
        返回空游标、File.exists() 对外置存储一律 false）—— 装了却扫不到本地音乐。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- 存储权限适配 (API 23~32) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <!-- 自定义下载目录可能位于公共 Music/Download；Android 11+ 需要所有文件访问权限。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".LMApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LMPlayer"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 后台播放服务 (stopWithTask="false" 确保车机切换导航/清理任务栈时后台服务持续保活) -->
        <service
            android:name=".core.media.PlaybackService"
            android:exported="true"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- 安卓系统开机自动启动软件广播接收器 -->
        <receiver
            android:name=".core.media.BootCompletedReceiver"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- FileProvider 配置 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 桌面小部件（移植自 PR #3，贡献者 527934973）。全部不对外导出：
             小部件更新广播由系统发出，按钮命令只接收本 App 自己的显式 PendingIntent。 -->
        <receiver
            android:name=".core.widget.MusicWidgetProvider4x2"
            android:exported="false"
            android:label="@string/widget_4x2_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_4x2_info" />
        </receiver>


        <receiver
            android:name=".core.widget.MusicWidgetProvider2x1"
            android:exported="false"
            android:label="@string/widget_2x1_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x1_info" />
        </receiver>

        <receiver
            android:name=".core.widget.MusicWidgetProvider2x2"
            android:exported="false"
            android:label="@string/widget_2x2_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x2_info" />
        </receiver>


        <receiver
            android:name=".core.widget.MusicWidgetProvider3x3"
            android:exported="false"
            android:label="@string/widget_3x3_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_3x3_info" />
        </receiver>

        <receiver
            android:name=".core.widget.MusicWidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lm.player.action.WIDGET_TOGGLE" />
                <action android:name="com.lm.player.action.WIDGET_NEXT" />
                <action android:name="com.lm.player.action.WIDGET_PREV" />
                <action android:name="com.lm.player.action.WIDGET_FAVORITE" />
            </intent-filter>
        </receiver>

        <!-- 桌面悬浮搜索面板：直接在桌面上搜索并播放，不进入 App 主界面 -->
        <activity
            android:name=".core.widget.WidgetSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.LMPlayer.WidgetSearch"
            android:taskAffinity="${applicationId}.widgetsearch"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <receiver
            android:name=".core.widget.ChartWidgetProvider4x2"
            android:exported="false"
            android:label="@string/widget_chart_4x2_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chart_4x2_info" />
        </receiver>

        <receiver
            android:name=".core.widget.ChartWidgetProvider4x4"
            android:exported="false"
            android:label="@string/widget_chart_4x4_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chart_4x4_info" />
        </receiver>

        <receiver
            android:name=".core.widget.ChartWidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lm.player.action.CHART_TAB_HOT" />
                <action android:name="com.lm.player.action.CHART_TAB_SURGE" />
                <action android:name="com.lm.player.action.CHART_TAB_NEW" />
                <action android:name="com.lm.player.action.CHART_PLAY_ITEM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".core.widget.PlaylistWidgetProvider4x2"
            android:exported="false"
            android:label="@string/widget_playlist_4x2_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playlist_4x2_info" />
        </receiver>

        <receiver
            android:name=".core.widget.PlaylistWidgetProvider4x4"
            android:exported="false"
            android:label="@string/widget_playlist_4x4_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playlist_4x4_info" />
        </receiver>

        <receiver
            android:name=".core.widget.PlaylistWidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lm.player.action.PLAYLIST_TAB_MY" />
                <action android:name="com.lm.player.action.PLAYLIST_TAB_REC" />
                <action android:name="com.lm.player.action.PLAYLIST_OPEN" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

