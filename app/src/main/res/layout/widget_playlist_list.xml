<?xml version="1.0" encoding="utf-8"?>
<!--
  歌单小部件 · 竖向列表（竖屏手机使用；横屏 / 平板仍用宫格布局）。
  控件 ID 与宫格布局一致，由 PlaylistWidgetController 按方向选用；行高按桌面实际高度计算。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_r24">

    <ImageView
        android:id="@+id/widget_bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_overlay_r24" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Category Tabs & Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_playlist_my"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_tab_active"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="我的歌单"
                android:textColor="@color/widget_tab_active"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_playlist_rec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_widget_tab_inactive"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="推荐歌单"
                android:textColor="@color/widget_tab_inactive"
                android:textSize="11.5sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/playlist_header_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="精选 4 套"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>


        <!-- 竖向列表：最多 8 行（4x2 显示 4 行），行高由代码按实际高度设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/playlist_item_1"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/playlist_cov_box_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView
                        android:id="@+id/playlist_cov_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_cover_bg"
                        android:scaleType="centerCrop"
                        android:src="@drawable/widget_playlist_cover_ph" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playlist_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/widget_text_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/playlist_sub_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/playlist_play_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_widget_play_circle"
                    android:contentDescription="播放" />
            </LinearLayout>

