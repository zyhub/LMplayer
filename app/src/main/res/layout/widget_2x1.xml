<?xml version="1.0" encoding="utf-8"?>
<!--
  2x1 播控小部件：封面 | 歌名 / 歌手 / 上一首·播放·下一首。
  视觉沿用 Antigravity 小组件规范：主色氛围背景 + 约 78% 磨砂蒙版、22dp 圆角、主色播放圆钮。
  内容整体垂直居中，桌面格子变高时不会被拉伸（竖屏手机常见）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_r22">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_clip_r22"
        android:clipToOutline="true" />

    <ImageView
        android:id="@+id/widget_bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_overlay_r22" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_cover_bg"
            android:clipToOutline="true"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:text="LMPlayer" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:text="未在播放" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_prev"
                    android:contentDescription="上一首" />

                <FrameLayout
                    android:id="@+id/widget_btn_play_box"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="播放/暂停">

                    <ImageView
                        android:id="@+id/widget_btn_play_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_play_disc" />

                    <ImageView
                        android:id="@+id/widget_btn_play"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_widget_play" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/widget_btn_next"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_next"
                    android:contentDescription="下一首" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
